# Push notifications (Firebase Cloud Messaging)

# Enable or disable Firebase initialization and push delivery.
FIREBASE_ENABLED=true

# Option A: inline service account JSON (single line in .env)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# Option B: path to downloaded service account JSON file (relative to project root or absolute)
# FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# Test push endpoint
# Disabled by default in production. Enable locally for manual testing.
TEST_PUSH_ENABLED=false

# Optional shared secret for POST /api/test/push/ without TEST_PUSH_ENABLED=true
# Send as header: X-Test-Push-Secret: your-secret
TEST_PUSH_SECRET=

# Repeat push reminders while a warning stays active (webhook-triggered, no cron).
PUSH_REMINDER_MINUTES=30
